{
  "name": "Pawvoire",
  "version": "0.1.0",
  "packageManager": "pnpm@11.15.1",
  "type": "module",
  "author": "JedEatSnax (https://github.com/JedEatSnax)",
  "scripts": {
    "dev": "vinext dev",
    "build": "prisma generate && pnpm vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "preview": "pnpm run build && pnpm run start",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./worker-configuration.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint fix",
    "test": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/prisma-adapter": "^1.7.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tanstack/react-table": "^9.2.4",
    "@vinext/cloudflare": "latest",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dotenv": "^18.0.4",
    "lucide-react": "^1.48.0",
    "next-themes": "^0.4.6",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "latest",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vinext": "latest",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "oxlint": "^1.85.0",
    "prisma": "7.10.0",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "^5.0.2",
    "wrangler": "latest"
  }
}
